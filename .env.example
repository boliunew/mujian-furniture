# ---------- Admin ----------
# Password for /admin.html. On a live (https) site it must be 10+ characters and not an example.
ADMIN_PASSWORD=change-me
# Random string that signs the login cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ---------- Stripe ----------
# Stripe Dashboard → Developers → API keys. Use TEST keys (sk_test_...) first.
# Without a key: on your own computer checkout runs in demo mode (instant paid test orders);
# on a live site checkout is switched off, unless you set DEMO_MODE=1 for a public demo.
STRIPE_SECRET_KEY=
DEMO_MODE=
# From `stripe listen --forward-to localhost:4242/webhook`, or Dashboard → Webhooks. Starts with whsec_
STRIPE_WEBHOOK_SECRET=

# ---------- Site ----------
DOMAIN=http://localhost:4242
STORE_NAME=Mujian Furniture
# Return address on labels. Use | between lines.
STORE_ADDRESS=1200 Industrial Way|Oakland, CA 94607
STORE_EMAIL=orders@example.com
STORE_PHONE=(510) 555-0100
# Time zone for delivery dates and cutoffs
STORE_TZ=America/Los_Angeles

# ---------- Email (optional) ----------
# Shipping notifications to customers. Gmail: smtp.gmail.com, port 587, and an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
