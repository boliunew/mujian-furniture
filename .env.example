# Stripe Dashboard → Developers → API keys. Use TEST keys (sk_test_...) until you're ready.
STRIPE_SECRET_KEY=sk_test_replace_me

# From `stripe listen --forward-to localhost:4242/webhook` (local)
# or Dashboard → Developers → Webhooks (production). Starts with whsec_
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Where the site is reachable. Change to https://yourdomain.com in production.
DOMAIN=http://localhost:4242

# Password for /admin/orders?key=... (leave empty to disable that page)
ADMIN_KEY=
